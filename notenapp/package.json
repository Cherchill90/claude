{
  "name": "notenapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/grades.test.js src/csv.test.js src/merge.test.js src/synccrypto.test.js src/filesync.test.js electron/backup.test.cjs electron/syncserver.test.cjs electron/filesync.test.cjs",
    "app": "vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "ios": "vite build && npx cap sync ios && npx cap open ios",
    "ios:sync": "vite build && npx cap sync ios",
    "web:publish": "vite build && rm -rf ../docs && cp -r dist ../docs && touch ../docs/.nojekyll"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  },
  "main": "electron/main.cjs",
  "description": "Notenverwaltung für Lehrkräfte",
  "author": "Notenapp",
  "build": {
    "appId": "de.notenapp.desktop",
    "productName": "Notenapp",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/*.test.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-"
    },
    "dmg": {
      "title": "Notenapp"
    }
  }
}
